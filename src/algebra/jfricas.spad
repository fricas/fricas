)if LiterateDoc
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\documentclass{article}
\usepackage{literatedoc}
\begin{document}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\title{jFriCAS: A bridge between FriCAS and a Jupyter notebook}
\author{Ralf Hemmecke}
\date{01-Jun-2026}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\maketitle

\begin{abstract}
  This package provides the bridge between FriCAS and a Jupyter
  notebook via the Hunchentoot webserver.
\end{abstract}

\tableofcontents

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\section{Overview}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

The jFriCAS Jupyter notebook frontend for FriCAS was designed to be
used also with the new formatting framework of FriCAS, in particular
with the FormatMathJax domain. See \path{fmtjfricas.spad}.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\section{Implementation}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\subsection{The JFriCAS package}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
)endif

)abbrev package JFRICAS JFriCAS
++ The JFriCAS package contains functions to start a webserver and to
++ initialize ioHooks for the communication between FriCAS and the
++ Jupyter frontend. It also manages the communication between FriCAS
++ (via the Hunchentoot webserver) and the Jupyter notebook.
JFriCAS: Exports == Implementation where
  evalLisp(s) ==> EVAL(READ_-FROM_-STRING(s)$Lisp)$Lisp
  NN ==> NonNegativeInteger
  ZZ ==> Integer
  LS ==> List String
  SEX ==> SExpression
  HT ==> XHashTable(String, String)

  Exports ==> with
    initialize : () -> Void
      ++ initialize() defines a number of functions for jFriCAS to work.
    start : NN -> Boolean
      ++ start(p) initializes jFriCAS and starts a new webserver
      ++ instance on port p. It returns true if successful and false
      ++ if the hunchentoot webserver is not available.

    jfricasIOHandler : (Symbol, SEX) -> Void
      ++ jfricasIOHandler(s) reacts on certain ioHooks and writes out
      ++ begin and end markers to stdout so that the corresponding
      ++ fricaskernel.py can single out the various kinds of messages
      ++ that comes from FriCAS.

    handleOutput : (Boolean, String) -> String
      ++ handleOutput(err?, out) translates the output out into a string
      ++ that contains a JSON structure that is to be understood by
      ++ fricaskernel.py.

      ++ The function interprets the "--FORMAT:BEG:"/"--FORMAT:END:"
      ++ pairs, in particular reads off the step number from their end
      ++ and groups the output into substructures indexed by the step
      ++ number of FriCAS.

      ++ The JSON record looks like
      ++ {"error?": true, "souts": [s1,..., sn]}
      ++ where 'error?' is either True or False (depending on whether
      ++ or not the evaluation produced an error) and the responses si
      ++ are dictionaries that represent stepped outputs, i.e are of
      ++ the form {"step": step, "outs": [o1, ..., om]} and the oi are
      ++ of the form {content_type: content}. Note that content_type
      ++ can be "ERROR", which means that the respective content is an
      ++ error message or is content that was outside of e
      ++ "--FORMAT:BEG:"/"--FORMAT:END:" pair.

    kernel : () -> Void
      ++ kernel() writes out a file kernel.json to the current
      ++ directory. This file should be installed together
      ++ fricaskernel.py (generated by the fricaskernel() function
      ++ call) in your jupyter/python environment.

    fricaskernel : () -> Void
      ++ fricaskernel() writes out a file fricaskernel.py to the
      ++ current directory. This file should be installed together
      ++ kernel.json (generated by the kernel() function call) in your
      ++ jupyter/python environment.

    extendConstructorURLs : (HT, String) -> HT
      ++ extendConstructorURLs(h,url) creates a copy of \spad{h} where
      ++ each constructor name that is not yet existing in h gets an
      ++ entry with value \spad{url}.
    addLinks : HT -> String -> String
      ++ addLinks(ht)(type) returns a string that for every
      ++ constructor \spad{c} that appears as a string in the keys of
      ++ \spad{ht} a link to the online API constructor
      ++ documentation of \spad{c}.
    setTranslateType! : (String -> String) -> (String -> String)
      ++ setTranslateType!(fun) sets the function fun that is used in
      ++ \spad{handleOutput} to translate the type returnd by FriCAS
      ++ into something more pleasing to the user.
      ++ A good candidate for \spad{fun} is \spad{addLinks(h)} for a
      ++ respective hashtable constructed via
      ++ \spad{extendConstructorURLs}.

  Implementation ==> add
    import from String

    initialized? : Boolean := false

    setIOHook(fun : (Symbol, SEX) -> Void) : Void == set_spad_io_hook(fun)$Lisp

    ioIndexZZ() : Integer ==
        sex : SEX := evalLisp("|$IOindex|")@SEX
        integer? sex => integer sex
        -1

    ioIndex(n : Integer) : String ==
        z: Integer := ioIndexZZ() + n
        z > 0 => string z
        "0"

    sayMarker(markertype : String, n : Integer): Void ==
        evalLisp("(|sayMSG| _"--FORMAT:" markertype ":" ioIndex(n) "_")")
        void()

    jfricasIOHandler(s : Symbol, sex : SEX) : Void ==
        key : String := string s
        be : String := ""
        -- We only care about ioHooks that start with "start" or "endOf".
        if prefix?("start", key) then be := "BEG"
        if prefix?("endOf", key) then be := "END"
        be = "" => void() -- marker not known ==> do nothing

        -- Some ioHooks (especially formats) end in "Output", like
        -- "startAlgebraOutput", "endOfFormattedOutput", startTeXOutput" etc.
        -- See i-output.boot.
        if suffix?("Output", key) then key := delete(key, #key-5 .. #key)
        key := delete(key, 1..5) -- remove "start"/"endOf"
        markertype : String := be ":" key -- gives BEG:Algebra, END:TeX, or ...

        -- Unfortunately, when Time or Storage is printed by FriCAS,
        -- the $IOindex has already been increased, so we must
        -- decrease it here to assign the right step counter to the
        -- Time and Storage markers.
        -- See processInteractive0 in i-toplev.boot.
        key = "Time" or key = "Storage" => sayMarker(markertype, -1)

        -- We don't include SysCmd here, because that would lead to
        -- output of the form
        --   --FORMAT:BEG:SysCmd:n
        --   ...
        --   --FORMAT:BEG:KeyedMsg:n
        --   ...
        --   --FORMAT:END:KeyedMsg:n
        --   --FORMAT:END:SysCmd:n
        -- and, therefore, a marker pair included in another marker pair.
        -- We avoid that and do not treat such a situation with our code.
        -- Rather, we take every output that is not inside a marker pair
        -- as belonging to the special content type 'ERROR'.
        --
        -- With the same argument, we also do not need to treat
        -- PatternMsg (output belonging to the call of the 'error'
        -- function) and ErrorMsg.
        import from List String
        for f in [_
                  "Type",_
                  "Formatted",_
                  "Algebra",_
                  "Fortran",_
                  "HTML",_
                  "MathML",_
                  "TeXmacs",_
                  "TeX",_
                  "KeyedMsg"] | f = key repeat return sayMarker(markertype, 0)
        void()

    formatTypeTimeStorage(line : String) : String ==
        "<div style=\_"text-align:right;\_"><small>" line "</small></div>"

    -- The output is sectioned by lines that look like
    -- --FORMAT:BEG:format:n
    -- and
    -- --FORMAT:END:format:n
    -- where where 'format' is specifying the type of content like
    -- 'Formatted', 'Algebra', 'Type', 'Time', 'Storage', etc.
    -- and n is the step number that will be used for Out[n] in Jupyter.
    -- The <content> in
    -- --FORMAT:BEG:Formatted:n
    -- <content>
    -- --FORMAT:END:Formatted:n
    -- may contain the various formats that Formatted supports.
    -- They should have been set via setFormat! or setFormats! from the
    -- package JFriCASSupport. In particular, each of those outputs comes
    -- included in
    -- --FORMAT:BEG:format
    -- and
    -- --FORMAT:END:format
    -- and are counted to belong to step number n from the Formatted:n
    -- wrapper.
    --
    -- The special content type "ERROR" is used to signal output to stderr.

    -- The function addSteppedOutputs is a helper function for
    -- steppedOutputs. it prepends a new "stepped-output-record" to
    -- the list souts if there are some outputs available.
    addSteppedOutputs(souts : LS, step : String, outputs: LS) : LS ==
        empty? outputs => souts
        outs: String := join(",", reverse! outputs)
        sout: String := concat ["{_"step_": ",step,", _"outs_": [",outs,"]}"]
        cons(sout, souts)

    -- The function jsonEscape is only used in jsonEscapeString.
    -- It replaces JSON special character by its corresponding
    -- escape sequence so that it can happily live inside a JSON structure.
    jsonEscape(c : Character) : String ==
        c = char "_"" => "\_""
        c = char "\" => "\\"
        ord c >= 32 => c::String
        c = char 8   => "\b" -- backspace
        c = char 10  => "\n" -- new line
        c = char 12  => "\f" -- formfeed
        c = char 13  => "\r" -- carriage return
        s: String := "\u00" (if ord c < 16 then "0" else "1")
        concat(s, "0123456789ABCDEF".((ord(c) rem 16)+1))

    -- The function jsonEscapeString is only used in steppedOutputs.
    jsonEscapeString(s : String) : String ==
        lc: List Character :=
           concat([char "_"", char "\"], [char i for i in 0..31])
        special: CharacterClass := charClass lc
        zero?(e: Integer := position(special, s, 1)) => s -- no special character
        t: String := ""
        b: Integer := 1
        while e > 0 repeat
            t := t s(b..e-1) jsonEscape(s.e)
            e := position(special, s, b := e+1)
        rightTrim(t s(b..), char " ") -- append rest and remove trailing " "

    extendConstructorURLs(h : HT, url: String): HT ==
        LSY ==> List Symbol
        ht: HT := table()
        -- Get hold of all FriCAS constructors.
        rec: Record(categories: LSY, domains: LSY, packages: LSY) :=
            all_constructors()$BrowserInformation
        for c in concat [rec.categories, rec.domains, rec.packages] repeat
            s := string c
            ht.s := elt(h, s, url)
        ht

    addLinks(h : XHashTable(String, String)) : String -> String ==
        defaultURL: String :=
            if empty? h then "https://fricas.github.io/api/" else ""
        (s : String) : String +->
            idchars : CharacterClass := union(alphanumeric(), charClass("__"))
            result : String := ""
            i : Integer := 1 -- start at index 1
            n : Integer := #s
            while i <= n repeat
                -- find the next CamelCase word (an upper case letter is enough)
                p : Integer := position(upperCase(), s, i)
                zero? p => return result s(i..)
                j : Integer := p -- j >= i
                while j <= n and member?(s.j, idchars) repeat j := j+1
                id: String := s(p..j-1)
                url: String := elt(h, id, defaultURL)
                result :=
                    empty? url => concat(result, s(i..j-1))
                    concat [result, s(i..p-1),_
                      "<a href=\_"", url, id, ".html\_" target=\_"__blank\_" ",_
                      "style=\_"color:blue;text-decoration:none;\_">",_
                      id, "</a>"]
                i := j -- set the new starting index
            result

    translateType: Reference(String -> String) := ref addLinks table()
    setTranslateType!(fun: String -> String): String -> String ==
        setref(translateType, fun)

    -- The function steppedOutputs takes the output returned by a
    -- FriCAS evaluation and puts the contents between the
    -- "--FORMAT:BEG:" and "--FORMAT:END:" markers into a JSON data
    -- structure.
    steppedOutputs(out : String) : String ==
        trType: String -> String := deref translateType
        souts: List String := []
        outputs: List String := []
        step: String := "0"
        lines: List String := split(out, newline())
        while not empty? lines repeat
            content_type: String := "text/plain" -- default
            line: String := jsonEscapeString first lines
            lines := rest lines

            -- Ignore empty lines and '--FORMAT:END:Formatted' marker.
            line = "" or line(1..min(23,#line)) = "--FORMAT:END:Formatted:" =>
                iterate

            -- In the following we misuse the content_type field with
            -- the value "ERROR" to signal that the output should be
            -- send as text to stderr.
            line(1..min(13,#line)) ~= "--FORMAT:BEG:" => -- iterate
                outputs := cons("{_"ERROR_": _"" line "\n_"}", outputs)

            y: String := line(14..) -- remove "--FORMAT:BEG:"
            p: Integer := position(char ":", y)
            if zero? p then
                f := y
            else -- extract step number from the value after ':'
                f := y(1..p-1)
                nstep: String := y(p+1..)
                -- If the new step number is different from the old
                -- one, we finish the current output collection and
                -- start a new one.
                if nstep ~= step then
                    souts := addSteppedOutputs(souts, step, outputs)
                    outputs := []
                    step := nstep

            content: String := ""
            end_marker := "--FORMAT:END:" y

            -- Formatted is only a wrapper for the formatted
            -- output types that come with there own
            -- '--FORMAT:BEG:' and '--FORMAT:END' markers, but
            -- without the step number. '--FORMAT:BEG:Formatted:n'
            -- is only used to set the variable nstep.
            if line(1..min(23,#line)) = "--FORMAT:BEG:Formatted:" then iterate

            member?(f, ["Type", "Time", "Storage"]) => -- iterate
                line := first lines
                lines := rest(lines, 2) -- step over end marker
                -- "Type: " is removed, "Time: " and "Storage: " are kept.
                p := position(f ": ", line, 1) -- assert p>0
                if f = "Type" then
                    content := trType line(p+6..) -- type
                else
                    content := line(p..) -- time/storage
                fcontent: String := formatTypeTimeStorage content
                outputs := cons("{_"text/html_": _"" fcontent "_"}", outputs)

            -- Map formats to content types (ignoring formats that
            -- default to content_type = 'text/plain')
            if f = "FormatMathJax" then
                content_type := "text/latex"
            else if member?(f, ["MathML", "HTML"]) then
                content_type := "text/html"
            else if f = "TeX" then
                content_type := "text/latex"
                content := jsonEscapeString concat [_
                    "$",_
                    "\def\sp{^}\def\sb{__}\def\leqno(#1){}",_
                    "\def\erf\{\mathrm{erf}}\def\sinh{\mathrm{sinh}}",_
                    "\def\zag#1#2{{{\left.{#1}\right|}\over{\left|{#2}\right.}}}",_
                    "$ "]
            else if f = "KeyedMsg" then
                content_type := "ERROR"

            -- Collect the lines into content until the end_marker is found
            while not empty? lines repeat
                line: String := jsonEscapeString first lines
                lines := rest lines
                if line = end_marker then break
                content := concat(content, line "\n")

            outputs := cons("{_"" content_type "_": _"" content "_"}", outputs)

        -- Append the final block of outputs after the loop finishes
        return join(",", reverse! addSteppedOutputs(souts, step, outputs))


    handleOutput(err? : Boolean, out : String) : String ==
        concat ["{_"error?_": ", (if err? then "true" else "false"),_
                ", _"souts_": [", steppedOutputs out, "]}"]


    defineHandler(name : String, handler : String) : SEX ==
      evalLisp concat [_
        "(hunchentoot:define-easy-handler ",_
        "    (fricas-" name " :uri _"/" name "_") (code)",_
        "  (setf (hunchentoot:content-type*) _"text/plain_")",_
        "  (format nil _"~A~%_" " handler "))"]


    initialize() : Void ==
        setTranslateType!(addLinks
            extendConstructorURLs(table(), "https://fricas.github.io/api/"))

        -- The output of fricas can be found on stdout and stderr. So
        -- we create a string-output-stream 'jfricas-stream' in order
        -- to catch this output.
        evalLisp "(defvar jfricas-stream (make-string-output-stream))"

        -- In our function, we want to capture everything that goes to
        -- Lisp standard output. By making Lisp standard output a
        -- synonym for proxy_stdout, we ensure that binding
        -- proxy_stdout redirects all output that goes through Lisp
        -- standard output.
        evalLisp "(defvar proxy_stdout *standard-output*)"

        evalLisp
          "(setf *standard-output* (make-synonym-stream 'proxy_stdout))"

        -- We need to re-initialize FriCAS streams so that they use
        -- our version of standard output, see src/interp/setvars.boot.
        formats: List String := ["Algebra", "Fortran", "Mathml", "Texmacs",
                                 "Html", "OpenMath", "Tex", "Formatted"]
        for f in formats repeat
            evalLisp("(|setOutput" f "| '|%initialize%|)")

        -- fricaskernel.py expects the output in form of a json record.
        evalLisp concat [_
          "(defun jfricas-eval (input)",_
          "  (setf |$MARGIN| 0)",_
          "  (setf |$print_equatnum| NIL)",_
          "  (let* ((proxy_stdout jfricas-stream)",_
          "         (*error-output* proxy_stdout)",_
          "         (handle-output",_
          "           (|getFunctionFromDomain| '|handleOutput| '(|JFriCAS|)",_
          "                                    '(|Boolean| |String|)))",_
          "        (error? (eq (catch 'SPAD_READER (catch '|top_level|",_
          "                           (|interpret_block| input)))",_
          "                    '|restart|))",_
          "        (out (get-output-stream-string jfricas-stream))",_
          "        )",_
          "    (spadcall error? out handle-output)))"]

        -- The function jfricas-oneline-eval is only intended to call
        -- FriCAS and return its result with one-line code.
        evalLisp concat [_
          "(defun fricas-eval (code)",_
          "  (format nil _"~{~A~%~}_" (|parseAndEvalToString| code)))"]

        -- Make the url
        -- http://localhost:PORT/jfricas?code=D(sin(x),x) available.
        defineHandler("jfricas", "(jfricas-eval code)")

        -- Make the url
        -- http://localhost:PORT/fricas?code=D(sin(x),x) available.
        defineHandler("fricas", "(fricas-eval code)")

        setIOHook(jfricasIOHandler)


    -- Start the hunchentoot webserver on port p.
    start(p : NN) : Boolean ==
        if not initialized? then
            webserver := evalLisp("(member ':HUNCHENTOOT *features*)")::SEX
            if not empty? destruct webserver then
                initialize()
                initialized? := true
        evalLisp concat [_
          "(hunchentoot:start",_
          "  (make-instance 'hunchentoot:easy-acceptor :port " string(p) "))"]
        initialized?


    kernel() : Void ==
        tf: TextFile := open("kernel.json"::FileName, "output")$TextFile
        w(s) ==> writeLine!(tf, s)
        w "{"
        w "  _"argv_": [_"python3_", _"-m_", _"jfricas.fricaskernel_", _"-f_", _"{connection_file}_"],"
        w "  _"display_name_": _"FriCAS_","
        w "  _"language_": _"spad_""
        w "}"
        close! tf
        void()

    fricaskernel() : Void ==
        tf: TextFile := open("fricaskernel.py"::FileName, "output")$TextFile
        w(s) ==> writeLine!(tf, s)

        w "# -*- coding: utf-8 -*-"

        w "from ipykernel.kernelbase import Kernel"
        w "from subprocess import Popen, run, PIPE, STDOUT"
        w "import requests"
        w "import json"
        w "import os"

        w "____version____ = '3.0.0'"

        w "try:"
        w "    import notebook.notebookapp"
        w "    static__file__path = notebook.notebookapp.DEFAULT__STATIC__FILES__PATH"
        w "except:"
        w "    static__file__path = None"

        -- Function to find a free port"
        w "def get__free__port():"
        w "    import socket"
        w "    s = socket.socket(socket.AF__INET, socket.SOCK__STREAM)"
        w "    s.bind(('',0))"
        w "    s.listen(1)"
        w "    port = s.getsockname()[1]"
        w "    s.close()"
        w "    return port"

        -- Get new free port"
        w "htport = str(get__free__port())"

        -- PID of FriCAS+HT"
        w "pid = None"

        -- httpFriCAS is the connection to FriCAS via a webserver.
        w "class httpFriCAS():"
        w "    def ____init____(self, port = htport):"
        w "        self.url = 'http://localhost:' + port + '/jfricas'"
        w "    def fricas(self, code):"
        w "        return(requests.post(self.url, data={'code': code}))"

        w "class FriCAS(Kernel):"
        w "    implementation = 'spad'"
        w "    implementation__version = ____version____"
        w "    language = 'spad'"
        w "    language__version = '0.1'"
        w "    language__info = {'name': 'spad', 'mimetype': 'text/plain',"
        w "                     'file__extension': '.input',}"
        w "    banner = 'FriCAS Jupyter Kernel'"

        w "    def ____init____(self, **kwargs):"
        w "        Kernel.____init____(self, **kwargs)"
        w "        self.server = httpFriCAS()"
        w "        self.fricas__operations = fricas__operations"
        w "        self.fricas__constructors = fricas__constructors"
        w "        self.fricas__ids = sorted(fricas__operations + fricas__constructors)"

        w "    def execute__block(self, block, silent):"
        w "        if block.startswith(')'):"
        w "            cmd = block[1:]"
        --             # )if, )else, )endif, and )fin commands are no-ops, i.e. ignored.
        w "            if cmd in ['if', 'else', 'endif', 'fin']: return True"
        --             # We abort evaluation at a )quit or )pquit situation.
        w "            if cmd.startswith('p'): cmd = cmd[1:]"
        w "            if cmd in ['q', 'qu', 'qui', 'quit']:"
        w "                self.send__response(self.iopub__socket, 'stream',"
        w "                    {'name': 'stderr', 'text': 'Use the menu _"File -> Close and Shut Down Notebook_" to quit the notebook!'})"
        w "                return False"
        w "        r = self.server.fricas(block)"
        w "        if silent: return True"
        w "        if not r.ok: return False"
        w "        fresult = r.json()" -- resulting json from FriCAS
        w "        stepped_outputs = fresult['souts']"
        w "        if fresult['error?']:"
        w "            for so in stepped_outputs:"
        w "                for data in so['outs']:"
        w "                    for k in data.keys():" -- content_type
        w "                        self.send_response(self.iopub_socket, 'stream',"
        w "                            {'name': 'stderr', 'text': data[k]})"
        w "            return False"

        w "        for so in stepped_outputs:"
        w "            if not so['outs']: continue"
        w "            is__first = True"
        w "            for data in so['outs']:"
        w "                if data.get('ERROR'):"
        w "                    self.send_response(self.iopub_socket, 'stream',"
        w "                        {'name': 'stderr', 'text': data.get('ERROR')})"
        w "                elif is__first:"
        w "                    self.send_response(self.iopub_socket, 'execute_result',"
        w "                        {'execution_count': so['step'],"
        w "                         'data': data, 'metadata': {}})"
        w "                    is__first = False"
        w "                else:"
        w "                    self.send_response(self.iopub_socket,'display_data',"
        w "                        {'data': data, 'metadata': {}})"
        w "        return True"

        -- This is the primary method Jupyter calls when you press"
        -- SHIFT+ENTER on a cell."
        -----------------------------------------------------------
        -- It would be enough to send just the whole code string,
        -- because jfricas.spad takes care if the code consists of
        -- several lines. However, if, for example, the input cell
        -- contains the following code lines.
        --   2+3
        --   [1,]
        --   4+5
        -- and we send this to FriCAS as one block, then the evaluation
        -- stops at the second line and returns an error and output
        -- that contains a good evaluation of the first line and a
        -- error output for the second line.
        -- Unfortunately, all the output comes in one chunk and it is
        -- hard to detect what the actuall error message is.
        -- Therefore, we split the input into separate input blocks by
        -- the following rules
        -- (a) All whitespace is remove from the end of a line.
        -- (b) A line ending in __ (underscore) makes the next line
        --     belonging to the same block.
        -- (c) A line starting with a non-whitespace character begins
        --     a new input block.
        -- (d) All lines that begin with a space character are associated
        --     with the current block.
        -- Then we handle one block after the other.
        w "    def do__execute(self, code, silent, store__history=True,"
        w "                   user__expressions=None, allow__stdin=False):"
        w "        lines = code.split('\n')"
        w "        blocks = []"
        w "        block = ''"
        w "        for line in lines:"
        w "            line = line.rstrip()"
        w "            if not block:"
        w "                block = line"
        w "                continue"
        w "            l = len(block)" -- assert(l>0)
        w "            if block[l-1] == '__' or (line and line[0] == ' '):"
        w "                block += '\n' + line"
        w "                continue" -- # there may be more lines for the block
        w "            if not self.execute__block(block, silent):"
        w "                return {'status': 'error',"
        w "                        'execution__count': self.execution__count,"
        w "                        'payload':[], 'user__expressions':{}}"
        w "            block = line" -- start new block
        w "        if block:" -- treat last block if any
        w "            if not self.execute__block(block, silent):"
        w "                return {'status': 'error',"
        w "                        'execution__count': self.execution__count,"
        w "                        'payload':[], 'user__expressions':{}}"
        w "        return {'status': 'ok',"
        w "                'execution__count': self.execution__count,"
        w "                'payload':[], 'user__expressions':{}}"

        w "    def do__shutdown(self, restart):"
        w "        self.send__response(self.iopub__socket, 'stream',"
        w "            {'name': 'stdout', 'text': '-- Bye. Kernel shutdown '})"
        w "        try:"
        w "            r = self.server.fricas(')quit')"
        w "            pid.terminate()" -- terminate fricas+HT
        w "        except:"
        w "            print('Go down anyway ...')"
        w "        return {'restart': False}"

        -- get__identifier__part is an auxiliary function
        -- A FriCAS identifier consists of alpha-numeric characters
        -- and one of the letters ! ? __. For code completion and code
        -- inspection we ignore other fancy operators, i.e,, to find
        -- the start of the identifier, we go simply backwards from the
        -- current position until we find a non-admissible character.
        w "    def get__identifier__part(self, code):"
        w "        admissible = 'abcdefghijklmnopqrstuvwxyz__!?0123456789'"
        w "        n = len(code)-1"
        w "        while n>=0 and code[n].lower() in admissible: n -= 1"
        w "        return code[n+1:]"

        -- This is activated when pressing TAB in a jupyter cell.
        w "    def do__complete(self, code, cursor__pos):"
        w "        code = code[:cursor__pos]"
        w "        token = self.get__identifier__part(code)"
        w "        start = cursor__pos - len(token)"
        w "        matches = [id for id in self.fricas__ids if id.startswith(token)]"
        w "        return {'matches': matches,"
        w "                'cursor__start': start,"
        w "                'cursor__end': cursor__pos,"
        w "                'metadata': dict(),"
        w "                'status': 'ok'}"

        -- This is activated when pressing SHIFT+TAB in a jupyter cell.
        w "    def do__inspect(self, code, cursor__pos, detail__level=0, *args, **kwargs):"
        w "        data = dict()"
        w "        code = code[:cursor__pos]"
        w "        token = self.get__identifier__part(code)"

        w "        if token in self.fricas__operations:"
        w "            r = self.server.fricas(')display operation ' + token)"
        w "        elif token in self.fricas__constructors:"
        w "            r = self.server.fricas(')show '+ token)"
        w "        else:"
        w "            return {'status' : 'ok', 'found' : False,"
        w "                    'data' :  {}, 'metadata' : {}}"

        w "        msg = 'No data from FriCAS'"

        w "        if r.ok:"
        w "            outs = r.json()['souts'][0]['outs']"
        w "            msg = ''.join([d['ERROR'] for d in outs])"

        w "        return {'status' : 'ok', 'found' : True,"
        w "                'data' : {'text/plain' : msg}, 'metadata' : {}}"

        w "if ____name____ == '____main____':"
        w "    from ipykernel.kernelapp import IPKernelApp"
        w "    import itertools"

        -- Get all FriCAS identifiers for tab-completion into the variables
        -- fricas__operations and fricas__constructors.
        -- We need this for do__complete and do__inspect.
        -- We start a separate process tho get this information.
        w "    pid0 = Popen(['fricas', '-nosman',"
        w "                 '-eval', ')what operations',"
        w "                 '-eval', ')what categories',"
        w "                 '-eval', ')what domains',"
        w "                 '-eval', ')what packages',"
        w "                 '-eval', ')quit'],stdout=PIPE,"
        w "                 env=dict(os.environ, FRICAS__INITFILE=''))"
        w "    out = pid0.stdout.readlines()"
        w "    lines = [s.decode('utf-8').rstrip() for s in out]"
        -- Look for line that start the ')what operations' output.
        w "    while not lines.pop(0).startswith('Operations whose names satisfy '): pass"
        w "    fricas__operations = []"
        w "    line = lines.pop(0)" -- skip empty line from beginning"
        w "    line = lines.pop(0)"
        w "    while line:"
        w "        fricas__operations.append(line)"
        w "        line = lines.pop(0)"
        -- operations already come sorted from FriCAS
        -- Look for line that starts the ')what categories' output,
        -- Regular expression: /^-+ Categories -*$/
        w "    while not lines.pop(0).startswith('--------------'): pass"
        w "    wordlist = [x.split() for x in lines if not x.startswith('--------------')]"
        w "    fricas__constructors = list(itertools.chain.from__iterable(wordlist))"
        w "    fricas__constructors.sort()"
        w "    start = 'start(' + htport + ')$JFriCAS'"

        w "    # A couple of ways to start FriCAS"
        w "    # --------------------------------"
        w "    # Uncomment or edit as you like."

        w "    # Default:"
        w "    pid = Popen(['fricas','-eval',start])"
        w ""
        w "    # Start the FriCAS process in a separate terminal."
        w "    # That might be good for controlling FriCAS directly in case"
        w "    # the Jupyter interface hangs or a process runs too long."
        w "    # Of course, the start-fricas-in-terminal way also works"
        w "    # with additional fricas options."
        w "    ## pid = Popen(['gnome-terminal', '--title=jfricas', '--'] +"
        w "    ##             ['fricas','-eval',start])"
        w ""
        w "    # Start the FriCAS process without opening the HyperDoc window."
        w "    ## pid = Popen(['fricas','-eval',start,'-noht'])"
        w ""
        w "    # Start the FriCAS process by calling only FRICASsys."
        w "    # The following does currently not work."
        w "    ## pid = Popen(['fricas','-nosman','-eval',start])"
        w "    # but"
        w "    ## pid = Popen(['gnome-terminal', '--title=jfricas', '--'] +"
        w "    ##             ['fricas','-nosman','-eval',start])"
        w "    # does."
        w ""
        w "    # Start the kernel."
        w "    IPKernelApp.launch__instance(kernel__class=FriCAS)"
        close! tf
        void()


)if LiterateDoc

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\end{document}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
)endif
