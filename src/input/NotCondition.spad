)abbrev domain NOTCDOM NotCondDom
++ An export under a negated condition.
NotCondDom(R : Ring) : with
    make : R -> %
    if not (R has Field) then
        foo : % -> Integer
  == add
    Rep := R
    make r == r pretend %
    if not (R has Field) then
        foo x == 1

)abbrev package NOTCPKG NotCondPkg
++ Uses foo of NotCondDom only where 'not (R has Field)' is known.
NotCondPkg(R : Ring) : with
    if not (R has Field) then
        bar : R -> Integer
  == add
    if not (R has Field) then
        bar r == foo(make(r)$NotCondDom(R))$NotCondDom(R)
