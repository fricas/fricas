)abbrev category PKARGC PackageArgumentCategory
PackageArgumentCategory : Category == with
    step : Integer -> Integer

)abbrev package PKARGP PackageArgumentStep
PackageArgumentStep : PackageArgumentCategory == add
    step(n) == n + 1

)abbrev package PKARGU PackageArgumentUser
PackageArgumentUser(S : PackageArgumentCategory) : with
    run : Integer -> Integer
  == add
    run(n) == step(n)$S
