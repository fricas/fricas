)abbrev category CARGCAT CategoryArgCat
++ Test of domain arguments with a category type (issue #209).
CategoryArgCat : Category == with
    foo : Integer -> Integer

)abbrev domain CARGD1 CategoryArgD1
CategoryArgD1 : CategoryArgCat == add
    foo(n : Integer) == 1

)abbrev domain CARGD2 CategoryArgD2
CategoryArgD2 : CategoryArgCat == add
    foo(n : Integer) == 2

)abbrev package CARGPKG CategoryArgPackage
CategoryArgPackage : with
    bar? : (CategoryArgCat, Integer) -> Integer -> Boolean
  == add
    bar?(D : CategoryArgCat, n : Integer) : Integer -> Boolean ==
        (x : Integer) : Boolean +-> foo(n + x)$D = 1
