)abbrev package MAPAFIF MappingAfterIf
MappingAfterIf() : with
    f : Integer -> Integer
  == add
    app(g : Integer -> Integer, x : Integer) : Integer == g(x)
    f(n) ==
        sign : Integer -> Integer
        sign := x +-> x + 1
        if sign(n)$Integer > 0 then
            sign := x +-> x + 100
        app(sign, n)
