)abbrev package LHCONST LocalHidesConstant
LocalHidesConstant() : with
    f : NonNegativeInteger -> List Integer
    g : NonNegativeInteger -> List Integer
  == add
    f(max) == [n for n in 1..max while n < 10]
    g(min) ==
        res : List Integer := []
        for n in min..min + 2 repeat res := cons(n, res)
        reverse!(res)
